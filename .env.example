# --- Optional: LLM planner for complex instructions (rule-based parser works without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-flash-lite-latest

# --- Browser ---
BROWSER_HEADLESS=false        # false = watch the real browser while it runs
BROWSER_SLOW_MO_MS=250
ACTION_TIMEOUT_MS=10000
NAV_TIMEOUT_MS=30000

# --- Safety / limits ---
MAX_STEP_RETRIES=2
MAX_TOTAL_ACTIONS=60
RUN_TIMEOUT_S=300
USER_RESPONSE_TIMEOUT_S=600
BLOCKED_DOMAINS=
ALLOW_PRIVATE_NETWORK=false

# --- Server / storage ---
HOST=127.0.0.1
PORT=5000
DEMO_BASE_URL=http://127.0.0.1:5000
DATA_DIR=./data
